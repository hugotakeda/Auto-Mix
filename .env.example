# ==========================================
# BOT (obrigatorio)
# ==========================================

# Token do bot (Discord Developer Portal -> Bot)
DISCORD_TOKEN=seu_token_aqui

# Client ID do bot (Developer Portal -> General Information)
CLIENT_ID=seu_client_id_aqui

# ID do servidor. Em dev, registra os comandos na hora.
# O site tambem usa esse ID pra saber de qual servidor e o ranking.
GUILD_ID=seu_guild_id_aqui


# >>> PREENCHER <<< ID do cargo de staff no Discord.
# Quem tiver este cargo ve a aba Staff e pode marcar/banir jogadores.
# Para pegar: Discord -> Config. do servidor -> Cargos -> clique direito no
# cargo -> Copiar ID (precisa do Modo Desenvolvedor ligado).
# Sem isto, a area de staff fica desligada e o site funciona normal.
STAFF_ROLE_ID=

# ==========================================
# SITE (obrigatorio pro site e pro envio de demo)
# ==========================================

# Developer Portal -> OAuth2 -> Client Secret
CLIENT_SECRET=seu_client_secret_aqui

# Assina o cookie de sessao. Gere com:  openssl rand -hex 32
SESSION_SECRET=troque_isso_por_32_bytes_aleatorios

# URL publica do site, SEM barra no fim.
# Precisa ser identica a redirect URI cadastrada no Developer Portal
# (OAuth2 -> Redirects), acrescida de /auth/callback.
#   Discloud: https://SEU-ID.discloud.app
#   Local:    http://localhost:8080
PUBLIC_URL=https://seu-id.discloud.app

# A Discloud exige 8080. Localmente pode ser qualquer uma.
PORT=8080
HOST=0.0.0.0

# Marque como false pra rodar so o bot, sem o site.
WEB_ENABLED=true

NODE_ENV=production

# ==========================================
# OPCIONAL
# ==========================================

# Sem a chave, links /id/nick sao resolvidos pelo endpoint publico ?xml=1
# e funciona do mesmo jeito. Com a chave, o /steam tambem mostra nome e avatar.
# Pegue em: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
