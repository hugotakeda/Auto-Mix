// TYPE=site (e nao bot) porque um app TYPE=bot nao recebe URL publica na
// Discloud. O mesmo processo continua rodando o bot do Discord normalmente —
// o TYPE so decide se a porta 8080 fica exposta num subdominio.
TYPE=site
ID=auto-mix
MAIN=dist/index.js
RAM=2048
AUTORESTART=true
VERSION=latest
APT=canvas
BUILD=npm install && npm run build:local
