{
  "name": "auto-mix",
  "version": "1.0.0",
  "description": "Bot de Discord para mix 5v5 automatico de Counter-Strike 2",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "build:local": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "node-cron": "^4.6.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/sql.js": "^1.4.9",
    "archiver": "^8.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
